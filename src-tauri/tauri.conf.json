{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Constellation",
  "version": "0.1.0",
  "identifier": "space.taskyon.constellation",
  "build": {
    "beforeBuildCommand": "yarn build:tauri:frontend",
    "beforeDevCommand": "yarn dev:tauri:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "security": {
      "capabilities": ["desktop", "mobile"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Constellation",
        "width": 430,
        "height": 860,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "android": {
      "minSdkVersion": 29
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["https"],
          "host": "constellation.taskyon.space",
          "pathPrefix": ["/"],
          "appLink": true
        }
      ]
    }
  }
}
