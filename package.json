{
  "name": "constellation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "vendor/taskyon/*"
  ],
  "type": "module",
  "packageManager": "yarn@4.16.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build:vendor": "yarn workspace @taskyon/protocol build && yarn workspace @taskyon/p2p-core build",
    "icons:generate": "tauri icon assets/icon-manifest.json -o src-tauri/icons",
    "dev": "yarn build:vendor && vite",
    "dev:tauri:frontend": "yarn build:vendor && vite --mode tauri",
    "build": "yarn build:vendor && vue-tsc --noEmit && vite build",
    "build:pages": "VITE_CONSTELLATION_PUBLIC_URL=https://constellation.taskyon.space/ yarn build && node scripts/prepare-pages.mjs",
    "test:pages": "yarn build:pages && node scripts/pages-preflight.mjs",
    "build:tauri:frontend": "yarn build:vendor && vue-tsc --noEmit && vite build --mode tauri",
    "build:desktop:release:appimage": "constellation-build-release-appimage",
    "build:desktop:release:appimage:internal": "tauri build --bundles appimage",
    "build:desktop:release:flatpak": "bash scripts/build-flatpak.sh",
    "build:android:background-runtime": "yarn build:vendor && vite build --config vite.background.config.ts",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "build:android:debug:x86_64-emulator": "bash scripts/with-android-build-tools.sh tauri android build --debug --apk --target x86_64 && node scripts/copy-android-apk.mjs debug x86_64",
    "build:android:debug:arm64-device": "bash scripts/with-android-build-tools.sh tauri android build --debug --apk --target aarch64 && node scripts/copy-android-apk.mjs debug aarch64",
    "build:android:release": "yarn build:android:release:arm64-device",
    "build:android:release:arm64-device": "bash scripts/build-android-release.sh",
    "android:signing:restore": "bash scripts/restore-android-keystore.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "vue-tsc --noEmit && eslint .",
    "typecheck": "yarn build:vendor && vue-tsc --noEmit",
    "test:android:config": "node scripts/check-android-config.mjs",
    "test:android:e2e": "node scripts/test-android.mjs",
    "test:android:managed": "node scripts/test-android-managed.mjs",
    "test:android:three-way": "node scripts/test-android-managed.mjs --three-way",
    "test:scripts": "node --test scripts/*.test.mjs",
    "licenses:inventory": "node scripts/license-inventory.mjs",
    "licenses:artifacts": "node scripts/artifact-license-inventory.mjs",
    "lint:flatpak": "node scripts/flatpak-lint.mjs",
    "test:unit": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:vendor": "yarn workspace @taskyon/protocol test && yarn workspace @taskyon/p2p-core test",
    "test": "yarn build:vendor && yarn test:vendor && yarn test:unit && yarn test:scripts",
    "test:e2e": "yarn build:vendor && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@libp2p/crypto": "5.1.23",
    "@libp2p/interface": "3.3.0",
    "@multiformats/multiaddr": "13.0.3",
    "@protomaps/basemaps": "5.7.2",
    "@taskyon/p2p-core": "workspace:*",
    "@taskyon/protocol": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.10",
    "@tauri-apps/plugin-geolocation": "2.3.3",
    "maplibre-gl": "5.23.0",
    "pmtiles": "4.4.1",
    "qrcode": "1.5.4",
    "vue": "3.5.22",
    "vue-router": "4.0.12",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.13.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.3",
    "@vue/eslint-config-prettier": "10.1.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.8.1",
    "eslint": "9.14.0",
    "eslint-plugin-vue": "10.4.0",
    "globals": "16.4.0",
    "prettier": "3.3.3",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.0.7"
  }
}
