{
  "name": "constellation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "vendor/taskyon/*"
  ],
  "type": "module",
  "packageManager": "yarn@4.16.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build:vendor": "yarn workspace @taskyon/protocol build && yarn workspace @taskyon/p2p-core build",
    "dev": "yarn build:vendor && vite",
    "dev:tauri:frontend": "yarn build:vendor && vite --mode tauri",
    "build": "yarn build:vendor && vue-tsc --noEmit && vite build",
    "build:tauri:frontend": "yarn build:vendor && vue-tsc --noEmit && vite build --mode tauri",
    "build:android:runtime": "yarn build:vendor && vite build --config vite.background.config.ts",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "build:android:dev": "bash scripts/with-android-build-tools.sh tauri android build --debug --apk --target x86_64 && node scripts/copy-android-apk.mjs debug x86_64",
    "build:android:device": "bash scripts/with-android-build-tools.sh tauri android build --debug --apk --target aarch64 && node scripts/copy-android-apk.mjs debug aarch64",
    "build:android:release": "bash scripts/build-android-release.sh",
    "typecheck": "yarn build:vendor && vue-tsc --noEmit",
    "test:android:config": "node scripts/check-android-config.mjs",
    "test:android:e2e": "node scripts/test-android.mjs",
    "test:android:managed": "node scripts/test-android-managed.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:vendor": "yarn workspace @taskyon/protocol test && yarn workspace @taskyon/p2p-core test",
    "test": "yarn build:vendor && yarn test:vendor && yarn test:unit && yarn test:scripts",
    "test:e2e": "yarn build:vendor && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@libp2p/interface": "3.3.0",
    "@multiformats/multiaddr": "13.0.3",
    "@taskyon/p2p-core": "workspace:*",
    "@taskyon/protocol": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.10",
    "@tauri-apps/plugin-geolocation": "2.3.3",
    "maplibre-gl": "5.23.0",
    "pmtiles": "4.4.1",
    "qrcode": "1.5.4",
    "vue": "3.5.22",
    "vue-router": "4.0.12",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.13.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.3",
    "@vue/tsconfig": "0.8.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vue-tsc": "3.0.7"
  }
}
